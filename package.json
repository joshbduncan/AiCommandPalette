{
    "name": "ai-command-palette",
    "version": "0.17.0",
    "description": "Adobe Illustrator Command Palette",
    "main": "src/index.ts",
    "scripts": {
        "check-menu-ids": "python3 scripts/command_ids.py check menu",
        "check-tool-ids": "python3 scripts/command_ids.py check tool",
        "next-ids": "python3 scripts/command_ids.py next",
        "build-strings": "zsh -c \"python3 scripts/build_strings.py | prettier --parser typescript > src/data/built_strings.ts\"",
        "build-commands": "zsh -c \"python3 scripts/build_commands.py | prettier --parser typescript > src/data/built_commands.ts\"",
        "copy-to-ai": "zsh -c \"for v in 2026 2027; do sudo cp AiCommandPalette.jsx /Applications/Adobe\\ Illustrator\\ $v/Presets.localized/en_US/Scripts; done\"",
        "build": "tsc",
        "postbuild": "zsh -c \"scripts/postbuild.sh\"",
        "dev": "chokidar 'src/**/*.ts' -c 'npm run build && npm run copy-to-ai'"
    },
    "keywords": [
        "adobe illustrator"
    ],
    "author": "Josh Duncan",
    "license": "MIT",
    "type": "commonjs",
    "dependencies": {
        "types-for-adobe": "^7.2.4"
    },
    "devDependencies": {
        "chokidar-cli": "^3.0.0",
        "npm-run-all": "^4.1.5",
        "typescript": "^5.4.5"
    }
}
